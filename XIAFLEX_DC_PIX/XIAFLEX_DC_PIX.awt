<objquestion id="1607340" parent="1607280" questiontype="multchoice" idtext="1607341" idvar="1607339" idVarAttempts="1607393" persist="true">
<name>Question 1</name>
<lastupdated>1769093025</lastupdated>
<questiontext>If a contracture persists 4 weeks after the first treatment, the healthcare provider (HCP) may __________ to facilitate cord disruption. </questiontext>
<actionitem actiontaken="show" target="object" targetobject="1607314">
<browserWnd />
</actionitem>
<actionitemincorrect actiontaken="show" target="object" targetobject="1607306">
<browserWnd />
</actionitemincorrect>
<feedbackmethodcorrect>3</feedbackmethodcorrect>
<feedbackmethodincorrect>3</feedbackmethodincorrect>
<maxallowedattempts>2</maxallowedattempts>
<methodfbformaxattempts>3</methodfbformaxattempts>
<actitemfbformaxattempts actiontaken="show" target="object" targetobject="1607328">
<browserWnd />
</actitemfbformaxattempts>
<objchoice idtext="1607347" idbutton="1607342">
<choicetext>perform a finger extension procedure</choicetext>
<feedbackmethod>0</feedbackmethod>
</objchoice>
<objchoice idtext="1607343" idbutton="1607344" correctanswer="true">
<choicetext>administer a second injection followed by a finger extension procedure</choicetext>
<feedbackmethod>0</feedbackmethod>
</objchoice>
<objchoice idtext="1607345" idbutton="1607346">
<choicetext>consider surgery</choicetext>
<feedbackmethod>0</feedbackmethod>
</objchoice>
<objchoice idtext="1607348" idbutton="1607349">
<choicetext>massage the cord for 20 minutes</choicetext>
<feedbackmethod>0</feedbackmethod>
</objchoice>
