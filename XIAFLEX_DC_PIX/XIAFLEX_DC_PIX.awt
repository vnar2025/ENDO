<objquestion id="1359232" parent="1359175" questiontype="multchoice" idtext="1359233" idvar="1359231" idVarAttempts="1359283" persist="true">
<name>Question 1</name>
<lastupdated>1769092737</lastupdated>
<questiontext>If a contracture persists 24 to 72 hours after the injection, the healthcare provider (HCP) may __________ to facilitate cord disruption. </questiontext>
<actionitem actiontaken="show" target="object" targetobject="1359209">
<browserWnd />
</actionitem>
<actionitemincorrect actiontaken="show" target="object" targetobject="1359201">
<browserWnd />
</actionitemincorrect>
<feedbackmethodcorrect>3</feedbackmethodcorrect>
<feedbackmethodincorrect>3</feedbackmethodincorrect>
<maxallowedattempts>2</maxallowedattempts>
<methodfbformaxattempts>3</methodfbformaxattempts>
<actitemfbformaxattempts actiontaken="show" target="object" targetobject="1359220">
<browserWnd />
</actitemfbformaxattempts>
<objchoice idtext="1359239" idbutton="1359234">
<choicetext>administer a second injection</choicetext>
<feedbackmethod>0</feedbackmethod>
</objchoice>
<objchoice idtext="1359235" idbutton="1359236">
<choicetext>consider surgery</choicetext>
<feedbackmethod>0</feedbackmethod>
</objchoice>
<objchoice idtext="1359237" idbutton="1359238" correctanswer="true">
<choicetext>perform a finger extension procedure</choicetext>
<feedbackmethod>0</feedbackmethod>
</objchoice>
<objchoice idtext="1359240" idbutton="1359241">
<choicetext>massage the joint for 20 minutes</choicetext>
<feedbackmethod>0</feedbackmethod>
</objchoice>
