<rtf>{\rtf1\ansi\deflang1033\ftnbj\uc1\deff1&#x0A;{\fonttbl{\f0 \froman \fcharset0 Times New Roman;}{\f1 \fswiss Arial;}{\f2 \froman \fcharset2 Symbol;}{\f3 \fmodern \fcharset0 Courier New;}{\f4 \fnil \fcharset2 Wingdings;}}&#x0A;{\colortbl\red0\green0\blue0 ;\red255\green255\blue255 ;\red23\green157\blue192 ;\red0\green0\blue0 ;}&#x0A;{\stylesheet{\f1\fs24\cf2\cb1\ulc3 Normal;}{\cs1\cf3\cb1\ulc3 Default Paragraph Font;}{\s2\snext0\cf3\cb1\ulc3 ;}{\s3\snext3\fs22\cf3\cb1\ulc3\li720\sa120 List Paragraph;}{\cs4\fs24\cf3\cb1\ulc3 List Paragraph Char;}}&#x0A;{\*\revtbl{Unknown;}}&#x0A;{\*\listtable&#x0A;{\list\listtemplateid1437790760&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01\&apos;b7}{\levelnumbers}\f2\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01o}{\levelnumbers}\f3\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01\&apos;a7}{\levelnumbers}\f4\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01\&apos;b7}{\levelnumbers}\f2\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01o}{\levelnumbers}\f3\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01\&apos;a7}{\levelnumbers}\f4\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01\&apos;b7}{\levelnumbers}\f2\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01o}{\levelnumbers}\f3\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01\&apos;a7}{\levelnumbers}\f4\fs24}&#x0A;{\listname ;}\listid489637493&#x0A;}&#x0A;}&#x0A;{\*\listoverridetable}&#x0A;\paperw12240\paperh15840\margl1800\margr1800\margt1440\margb1440\headery720\footery720\deftab360\formshade\aendnotes\aftnnrlc\pgbrdrhead\pgbrdrfoot&#x0A;\sectd\pgwsxn12240\pghsxn15840\marglsxn1800\margrsxn1800\margtsxn1440\margbsxn1440\headery720\footery720\sbkpage\pgncont\pgndec&#x0A;\plain\plain\f1\fs24\ql\lan