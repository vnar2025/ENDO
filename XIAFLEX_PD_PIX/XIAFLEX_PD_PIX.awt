<html>span.text505139Font3 { font-size:16px; font-family:&quot;Arial&quot;, sans-serif; color:#010101;}&#x0A;&lt;p  legLH=&quot;1.127&quot; style=&quot;margin-left:0px;text-indent:0px;line-height:1.080;margin-top:0px;margin-bottom:0px;text-align:left;&quot; &gt;&#x0A;&lt;span class=&quot;text505139Font3&quot;  &gt;Use the arrows at the bottom of the page to navigate one page at a time.&#x0A;&lt;/span &gt;&lt;/p &gt;&#x0A;&lt;p  legLH=&quot;1.127&quot; style=&quot;margin-left:0px;text-indent:0px;line-height:1.080;margin-top:0px;margin-bottom:0px;text-align:left;&quot; &gt;&#x0A;&lt;span class=&quot;text505139Font3&quot; style=&quot;background-color:transparent&quot; &gt;&#x0A;&amp;nbsp;&lt;/span &gt;&lt;/p &gt;&#x0A;&lt;p  legLH=&quot;1.127&quot; style=&quot;margin-left:0px;text-indent:0px;line-height:1.080;margin-top:0px;margin-bottom:0px;text-align:left;&quot; &gt;&#x0A;&lt;span class=&quot;text505139Font3&quot;  &gt;Upon completing the PI Explorer, a Table of Contents will be provided, allowing quick access to any page.&#x0A;&lt;/span &gt;&lt;/p &gt;&#x0A;</html>
<rtf>{\rtf1\ansi\deflang1033\ftnbj\uc1\deff1&#x0A;{\fonttbl{\f0 \froman \fcharset0 Times New Roman;}{\f1 \fswiss Arial;}{\f2 \fnil \fcharset2 Wingdings;}{\f3 \froman \fcharset2 Symbol;}{\f4 \fnil Verdana;}}&#x0A;{\colortbl\red0\green0\blue0 ;\red255\green255\blue255 ;\red0\green0\blue0 ;}&#x0A;{\stylesheet{\f1\fs24\cf2\cb1\ulc2 Normal;}{\cs1\cf2\cb1\ulc2 Default Paragraph Font;}{\s2\snext0\cf2\cb1\ulc2 ;}{\s3\snext3\fs20\cf2\cb1\ulc2\sa60 &gt;NXL_Normal;}{\cs4\f4\cf2\cb1\ulc2 &gt;NXL_Normal Char;}{\s5\snext5\fs20\cf2\cb1\ulc2\tx360\fi-360\li360\sa80 &#x0A;`NXL_Bullet;}{\s6\snext5\fs20\cf2\cb1\ulc2\tx360\sa80 `NXL_Bullet_2;}{\cs7\f4\cf2\cb1\ulc2 `NXL_Bullet Char;}}&#x0A;{\*\revtbl{Unknown;}}&#x0A;{\*\listtable&#x0A;{\list\listtemplateid1515899650&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01\&apos;a7}{\levelnumbers}\f2\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01-}{\levelnumbers}\f3\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01\&apos;a7}{\levelnumbers}\f2\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01-}{\levelnumbers}\f3\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01\&apos;a7}{\levelnumbers}\f2\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01-}{\levelnumbers}\f3\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01\&apos;a7}{\levelnumbers}\f2\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01-}{\levelnumbers}\f3\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01\&apos;a7}{\levelnumbers}\f2\fs24}&#x0A;{\listname ;}\listid285888238&#x0A;}&#x0A;}&#x0A;{\*\listoverridetable}&#x0A;\paperw12240\paperh15840\margl1800\margr1800\margt1440\margb1440\headery720\footery720\deftab360\formshade\aendnotes\aftnnrlc\pgbrdrhead\pgbrdrfoot&#x0A;\sectd\pgwsxn12240\pghsxn15840\marglsxn1800\margrsxn1800\margtsxn1440\margbsxn1440\headery720\footery720\sbkpage\pgncont\pgndec&#x0A;\plain\plain\f1\fs24\ql Use the arrows at the bottom of the page to navigate one page at a time.\par\par Upon completing the \lang1033\hich\f1\loch\f1 PI\plain\f1\fs24  Explorer, a Table of Contents will be provided, allowing quick access to any page.\par}&#x0A;</rtf>
