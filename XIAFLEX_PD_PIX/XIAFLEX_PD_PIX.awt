<text id="1817670" parent="1817664" visible="false" ontop="true" fixed="true" proportional="false" defaulttext="none" verticalscroll="true">
<name>ann_text</name>
<lastupdated>1769465171</lastupdated>
<respprops>
<tabletportrait>
<text>
<possize>
<size>
<cx>475</cx>
<cy>135</cy>
