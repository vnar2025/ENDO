<action id="1523205" parent="1523203" on="mouseclick">
<name>Transition Page Left</name>
<lastupdated>1764693134</lastupdated>
<actionitem actiontaken="runjavascript">
<targetstring>triv$(&quot;.page&quot;,getDisplayDocument()).css(&quot;left&quot;,function(){&#x0D;&#x0A;    triv$(&quot;.hideMe&quot;, getDisplayDocument()).css(&apos;visibility&apos;, &apos;hidden&apos;); &#x0D;&#x0A;    triv$(&quot;.luckyCharm&quot;, getDisplayDocument()).css(&apos;visibility&apos;, &apos;hidden&apos;); &#x0D;&#x0A;    triv$(&quot;.gterm&quot;, getDisplayDocument()).css(&apos;visibility&apos;, &apos;hidden&apos;); &#x0D;&#x0A;    triv$(this).css(&quot;transition&quot;,&quot;all .3s ease-in-out&quot;);&#x0D;&#x0A;    return &quot;-2000px&quot;;&#x0D;&#x0A;});</targetstring>
