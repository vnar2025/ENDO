<html>body {&#x0A;    margin:0px !important;&#x0A;    &#x0A;}&#x0A;html {&#x0A;    left: 0px !important;&#x0A;    top: 0px !important;&#x0A;    width: 100% !important;&#x0A;    z-index: -1 !important;&#x0A;    height: 100% !important;&#x0A;    clip: unset !important;&#x0A;    background: #ffffff !important;&#x0A;    //background: url(images/background-img.png) !important;&#x0A;    background-size: cover !important;&#x0A;}&#x0A;.background {&#x0A;    position: fixed !important;&#x0A;    left: 0px !important;&#x0A;    top: 0px !important;&#x0A;    width: 100% !important;&#x0A;    z-index: -1 !important;&#x0A;    height: 100% !important;&#x0A;    clip: unset !important;&#x0A;    background: #ffffff !important;&#x0A;    background: url(images/background-img.png) !important;&#x0A;    background-size: cover !important;&#x0A;}&#x0A;.DLG_titleBarLine {&#x0A;    height: 24px !important;&#x0A;    display: flex;&#x0A;    justify-content: center;&#x0A;    align-items: center;&#x0A;    background: #029ec0 !important;&#x0A;}&#x0A;.DLG_titleText {&#x0A;    font-size: 15px !important;&#x0A;    color:white !important;&#x0A;    text-shadow:none !important;&#x0A;}&#x0A;.DLG_content {&#x0A;    font-size: 20px !important;&#x0A;    font-family: Ariel sans-serif;&#x0A;}&#x0A;.DLG_titleBtns {&#x0A;  position: absolute !important;&#x0A;  right: 0px !important;&#x0A;  top: 5px !important;&#x0A;  width: 24px !important;&#x0A;  padding: 0px !important;&#x0A;  margin: 0px !important;&#x0A;  height: 11px !important;&#x0A;}&#x0A;input[name=&quot;OK&quot;] {&#x0A;  background: green;&#x0A;  color: white;&#x0A;  border-radius: 3px;&#x0A;  border:solid green;&#x0A;}&#x0A;input[name=&quot;Cancel&quot;] {&#x0A;  background: red;&#x0A;  color: white;&#x0A;  border-radius: 3px;&#x0A;  border:solid red;&#x0A;}&#x0A;input[name=&quot;OK&quot;]:hover {&#x0A; cursor:pointer;&#x0A; box-shadow: inset 1px 1px 6px 0px white;&#x0A;}&#x0A;input[name=&quot;Cancel&quot;]:hover {&#x0A;  cursor:pointer;&#x0A;  box-shadow: inset 1px 1px 6px 0px white;&#x0A;}&#x0A;.navButton{&#x0A;    background-color: white;&#x0A;    border-radius: 100%;&#x0A;}&#x0A;.currPage{&#x0A;    background-color:#179DC0;&#x0A;    color:white;&#x0A;    border-radius: 100%;&#x0A;}&#x0A;.flashcard{&#x0A;    background-image: url(images/q_a.png);&#x0A;    background-position: center;&#x0A;    border-radius: 100%;&#x0A;    background-size: contain;&#x0A;}&#x0A;.currPage.flashcard{&#x0A;    background-image: url(images/q_a_active.png);&#x0A;    background-position: center;&#x0A;    border-radius: 100%;&#x0A;    background-size: contain;&#x0A;}&#x0A;.cyp{&#x0A;    background-image: url(images/cyp.png);&#x0A;    background-position: center;&#x0A;    border-radius: 100%;&#x0A;    background-size: contain;&#x0A;}&#x0A;.currPage.cyp{&#x0A;    background-image: url(images/cyp_active.png);&#x0A;    background-position: center;&#x0A;    border-radius: 100%;&#x0A;    background-size: contain;&#x0A;}&#x0A;.final{&#x0A;    background-image: url(images/finished.png);&#x0A;    &#x0A;    background-position: center;&#x0A;    border-radius: 100%;&#x0A;    background-size: contain;&#x0A;}&#x0A;.currPage.final{&#x0A;    background-image: url(images/finished_active.png);&#x0A;    background-position: center;&#x0A;    border-radius: 100%;&#x0A;    background-size: contain;&#x0A;}&#x0A;/*CYP hover*/&#x0A;.answerOption {&#x0A;    display: block;&#x0A;}&#x0A;.quiz-can-hover .answerOption:hover {&#x0A;    background-color: #009CBD !important;&#x0A;    opacity: 0.5;&#x0A;}&#x0A;.quiz-can-hover .answerOption:hover,&#x0A;.quiz-can-hover .answerOption:hover * {&#x0A;    color: #ffffff !important;&#x0A;}&#x0A;.answerOption {&#x0A;    -webkit-user-select: none; /* Safari */&#x0A;    -moz-user-select: none;    /* Firefox */&#x0A;    -ms-user-select: none;     /* Old Edge */&#x0A;    user-select: none;         /* Standard */&#x0A;}&#x0A;</html>
