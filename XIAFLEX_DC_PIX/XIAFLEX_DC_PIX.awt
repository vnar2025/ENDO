<text id="1768211" parent="1768205" visible="false" ontop="true" fixed="true" proportional="false" publishasimage="true" defaulttext="none">
<name>ann_text</name>
<lastupdated>1769700711</lastupdated>
<respprops>
<tabletportrait>
