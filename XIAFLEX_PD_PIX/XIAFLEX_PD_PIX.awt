<text id="1768052" parent="1768046" visible="false" ontop="true" fixed="true" proportional="false" publishasimage="true" defaulttext="none">
<name>ann_text</name>
<lastupdated>1769700338</lastupdated>
<respprops>
<tabletlandscape>
