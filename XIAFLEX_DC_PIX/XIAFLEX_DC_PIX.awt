<text id="1805880" parent="1805874" visible="false" ontop="true" fixed="true" proportional="false" defaulttext="none" verticalscroll="true">
<name>ann_text</name>
<lastupdated>1769703409</lastupdated>
<respprops>
<tabletportrait>
<text>
<possize>
