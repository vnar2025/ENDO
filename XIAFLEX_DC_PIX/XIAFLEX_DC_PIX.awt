<rtf>{\rtf1\ansi\deflang1033\ftnbj\uc1\deff1&#x0A;{\fonttbl{\f0 \froman \fcharset0 Times New Roman;}{\f1 \fswiss Arial;}{\f2 \fnil \fcharset2 Wingdings;}{\f3 \froman \fcharset2 Symbol;}{\f4 \fswiss \fcharset0 Arial;}{\f5 \fnil Verdana;}}&#x0A;{\colortbl\red0\green0\blue0 ;\red255\green255\blue255 ;\red0\green156\blue189 ;\red0\green0\blue0 ;}&#x0A;{\stylesheet{\f1\fs24\cf3\cb1\ulc3 Normal;}{\cs1\cf3\cb1\ulc3 Default Paragraph Font;}{\s2\snext0\cf3\cb1\ulc3 ;}{\s3\snext3\fs20\cf3\cb1\ulc3\sa60 &gt;NXL_Normal;}{\cs4\f5\cf3\cb1\ulc3 &gt;NXL_Normal Char;}{\s5\snext5\fs20\cf3\cb1\ulc3\tx360\fi-360\li360\sa80 &#x0A;`NXL_Bullet;}{\s6\snext5\fs20\cf3\cb1\ulc3\tx360\sa80 `NXL_Bullet_2;}{\cs7\f5\cf3\cb1\ulc3 `NXL_Bullet Char;}}&#x0A;{\*\revtbl{Unknown;}}&#x0A;{\*\listtable&#x0A;{\list\listtemplateid1515899650&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01\&apos;a7}{\levelnumbers}\f2\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01-}{\levelnumbers}\f3\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01\&apos;a7}{\levelnumbers}\f2\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01-}{\levelnumbers}\f3\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01\&apos;a7}{\levelnumbers}\f2\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01-}{\levelnumbers}\f3\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01\&apos;a7}{\levelnumbers}\f2\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01-}{\levelnumbers}\f3\fs24}&#x0A;{\listlevel\levelnfc23\levelfollow0\levelstartat1{\leveltext \&apos;01\&apos;a7}{\levelnumbers}\f2\fs24}&#x0A;{\listname ;}\listid285888238&#x0A;}&#x0A;}&#x0A;{\*\listoverridetable}&#x0A;\paperw12240\paperh15840\margl1800\margr1800\margt1440\margb1440\headery720\footery720\deftab360\formshade\aendnotes\aftnnrlc\pgbrdrhead\pgbrdrfoot&#