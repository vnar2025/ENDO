<actionitem actiontaken="runjavascript">
<targetstring>let lc= triv$(&quot;.luckyCharm&quot;,getDisplayDocument());&#x0D;&#x0A;&#x0D;&#x0A;const classText = /visitedStateText/;&#x0D;&#x0A;let count = 0;&#x0D;&#x0A;&#x0D;&#x0A;for(let x =0;x&lt;lc.length;x++){&#x0D;&#x0A;    if(lc[x].children[0].children[1].className.match(classText)){&#x0D;&#x0A;        VariconList.add(x+1+&quot;_icon&quot;);&#x0D;&#x0A;        count++;&#x0D;&#x0A;    }&#x0D;&#x0A;}&#x0D;&#x0A;&#x0D;&#x0A;VarcurrentCount.set(count);</targetstring>
<browserWnd />
</actionitem>
</action>
