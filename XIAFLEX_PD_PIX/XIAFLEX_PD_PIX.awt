<text id="1806194" parent="1806188" visible="false" ontop="true" fixed="true" proportional="false" defaulttext="none" verticalscroll="true">
<name>ann_text</name>
<lastupdated>1769112365</lastupdated>
<respprops>
<tabletportrait>
<text>
<possize>
<size>
<cx>478</cx>
<cy>91</cy>
</size>
