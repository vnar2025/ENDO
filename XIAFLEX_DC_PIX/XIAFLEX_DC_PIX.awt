<html>span.text1878800Font1 { font-size:21px; font-family:&quot;Arial&quot;, sans-serif; color:#000000; font-weight:bold;}&#x0A;span.text1878800Font2 { font-size:13px; font-family:&quot;Arial&quot;, sans-serif; color:#000000; font-style:italic;}&#x0A;span.text1878800Font3 { font-size:19px; font-family:&quot;Arial&quot;, sans-serif; color:#000000;}&#x0A;&lt;p  legLH=&quot;1.192&quot; style=&quot;margin-left:0px;text-indent:0px;line-height:1.192;margin-top:0px;margin-bottom:0px;text-align:left;&quot; &gt;&#x0A;&lt;span class=&quot;text1878800Font1&quot;  &gt;Key Point&lt;br /&gt;&lt;/span &gt;&lt;span class=&quot;text1878800Font2&quot;  &gt;Scroll for more information.&lt;/span &gt;&lt;span class=&quot;text1878800Font3&quot; style=&quot;background-color:transparent&quot; &gt;&#x0A;&lt;/span &gt;&lt;/p &gt;&#x0A;</html>
