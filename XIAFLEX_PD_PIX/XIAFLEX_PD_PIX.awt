<objquestion id="1363835" parent="1363778" questiontype="multchoice" idtext="1550247" idvar="1363834" idVarAttempts="1363886" allowmultiple="true" persist="true">
<name>Question 1</name>
<lastupdated>1768428269</lastupdated>
<questiontext>Which of the following statements regarding acute post-injection back pain reactions with XIAFLEX treatment are TRUE? Select all that apply. </questiontext>
<actionitem actiontaken="show" target="object" targetobject="1363812">
<browserWnd />
</actionitem>
<actionitemincorrect actiontaken="show" target="object" targetobject="1363804">
<browserWnd />
</actionitemincorrect>
<feedbackmethodcorrect>3</feedbackmethodcorrect>
<feedbackmethodincorrect>3</feedbackmethodincorrect>
<maxallowedattempts>2</maxallowedattempts>
<methodfbformaxattempts>3</methodfbformaxattempts>
<actitemfbformaxattempts actiontaken="show" target="object" targetobject="1363823">
<browserWnd />
</actitemfbformaxattempts>
<objchoice idtext="1550248" idbutton="1550249" correctanswer="true">
<choicetext>May require observation and analgesic treatment </choicetext>
<feedbackmethod>0</feedbackmethod>
</objchoice>
<objchoice idtext="1550250" idbutton="1550251" correctanswer="true">
<choicetext>Typically resolve within 15 minutes </choicetext>
<feedbackmethod>0</feedbackmethod>
</objchoice>
<objchoice idtext="1550252" idbutton="1550253">
<choicetext>Most common adverse reaction in clinical trials  </choicetext>
<feedbackmethod>0</feedbackmethod>
</objchoice>
<objchoice idtext="1550254" idbutton="1550255" correctanswer="true">
<choicetext>May be associated with systemic symptoms including chest pain, headache, and dyspnea</choicetext>
<feedbackmethod>0</feedbackmethod>
</objchoice>
